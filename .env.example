# Clerk (https://dashboard.clerk.com)
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# Firebase client config
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Optional: Cloud Functions region (default us-central1)
EXPO_PUBLIC_FIREBASE_FUNCTIONS_REGION=us-central1

# Emulator lokal (opsional)
# EXPO_PUBLIC_USE_FUNCTIONS_EMULATOR=1

# JANGAN taruh di file ini (bukan untuk Expo app):
# CLERK_SECRET_KEY → functions/.env atau Firebase secrets
# XENDIT_SECRET_KEY → functions/.env atau Firebase secrets
